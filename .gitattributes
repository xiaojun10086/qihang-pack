# 自动识别文本文件并做 LF 归一
* text=auto

# ── 强制 LF ─────────────────────────────────────────────────
# 本机与用户机器上 core.autocrlf 可能为 true，checkout 时会把文本文件写成 CRLF，
# 导致 skill 文本与仓库基线不再逐字节一致（diff 全乱）。故对文本显式锁定 LF。
*.md    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.html  text eol=lf
*.mjs   text eol=lf
.gitattributes  text eol=lf
LICENSE         text eol=lf
